<%- include('partials/header', { title: 'Novo apontamento - ' + member.full_name }) %>

<h2 class="page-title">Novo apontamento: <%= member.full_name %></h2>

<div class="card">
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>
  <form method="POST" action="/members/<%= member.id %>/apontamentos">
    <label for="note">Apontamento</label>
    <textarea id="note" name="note" rows="6" required autofocus></textarea>
    <div class="actions-row" style="margin-top:1.5rem;">
      <button type="submit" class="btn btn-primary">Salvar apontamento</button>
      <a href="/members/<%= member.id %>/apontamentos" class="btn btn-outline">Cancelar</a>
    </div>
  </form>
</div>

<%- include('partials/footer') %>