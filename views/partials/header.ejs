<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Sistema de Membros' %> - IP Cambeba</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/img/logo-igreja2.png">
</head>
<body>
<% if (typeof admin !== 'undefined' && admin) { %>
<div class="navbar">
  <div class="brand">
    <img src="/img/logo-igreja2.png" alt="Igreja Presbiteriana do Cambeba">
  </div>
  <nav>
    <a href="/">Início</a>
    <a href="/members">Membros</a>
    <a href="/reports">Relatórios</a>
  </nav>
  <div class="user-box">
    Olá, <%= admin.name %>
    &nbsp;•&nbsp;
    <form class="logout-form" action="/logout" method="POST">
      <button class="logout-button" type="submit">Sair</button>
    </form>
  </div>
</div>
<% } %>
<div class="container">
